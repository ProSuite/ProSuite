<UserControl x:Class="ProSuite.AGP.Editing.DestroyAndRebuild.DockPaneDestroyAndRebuild"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
             xmlns:managedOptions="clr-namespace:ProSuite.Commons.UI.ManagedOptions;assembly=ProSuite.Commons.UI"
             xmlns:destroyAndRebuild="clr-namespace:ProSuite.AGP.Editing.DestroyAndRebuild"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="335"
             d:DataContext="{d:DesignInstance Type=destroyAndRebuild:DockPaneDestroyAndRebuildViewModelBase}">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<extensions:DesignOnlyResourceDictionary
					Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml" />

				<ResourceDictionary
					Source="/ProSuite.Commons.UI;component\ManagedOptions\SettingControls.xaml" />

			</ResourceDictionary.MergedDictionaries>

		</ResourceDictionary>
	</UserControl.Resources>

	<StackPanel
		HorizontalAlignment="Left"
		VerticalAlignment="Top" Width="Auto">

		<CheckBox Template="{StaticResource CentralizableSettingCheckbox}"
		          Content="Highlight the original geometry while sketching"
		          DataContext="{Binding Path=HighlightOriginalGeometry}" />
		<CheckBox Template="{StaticResource CentralizableSettingCheckbox}"
		          Content="Hide the edited feature while sketching"
		          DataContext="{Binding Path=HideEditedFeature}" />
		<CheckBox Template="{StaticResource CentralizableSettingCheckbox}"
		          Content="Move end junction in linear networks (toggle with M key)"
		          DataContext="{Binding Path=MoveOpenJawEndJunction}" />

		<!-- Restore Defaults -->
		<Button Template="{StaticResource RestoreDefaultsButton}" />

	</StackPanel>

</UserControl>
