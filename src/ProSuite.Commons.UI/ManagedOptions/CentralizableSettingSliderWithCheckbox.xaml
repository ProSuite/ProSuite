<UserControl x:Class="ProSuite.Commons.UI.ManagedOptions.CentralizableSettingSliderWithCheckbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ProSuite.Commons.UI.ManagedOptions"
             mc:Ignorable="d"
             x:Name="Root">
  <UserControl.Resources>
    <local:OverrideToFontStyleConverter x:Key="OverrideToFontStyleConverter" />
    <local:NumericToDoubleConverter x:Key="NumericToDoubleConverter" />
  </UserControl.Resources>

  <StackPanel>
    <!-- Label Row. Goes italic when the checkbox setting has a local override (the checkbox
         itself has no text content, so its override state is surfaced on the title). -->
    <TextBlock Text="{Binding Label, ElementName=Root}"
               VerticalAlignment="Center"
               TextWrapping="Wrap"
               FontStyle="{Binding CheckboxSetting.HasLocalOverride, ElementName=Root,
                           Converter={StaticResource OverrideToFontStyleConverter}}"
               Margin="0,0,0,5" />

    <!-- Checkbox + Slider + TextBox Row -->
    <Grid Margin="0,0,0,15">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="60" />
      </Grid.ColumnDefinitions>

      <CheckBox Grid.Column="0"
                DataContext="{Binding CheckboxSetting, ElementName=Root}"
                IsChecked="{Binding CurrentValue, Mode=TwoWay}"
                IsEnabled="{Binding IsEnabled}"
                FontStyle="{Binding HasLocalOverride, Mode=OneWay, Converter={StaticResource OverrideToFontStyleConverter}}"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="{Binding ToolTip}"
                VerticalAlignment="Center"
                Margin="0,0,10,0" />

      <Slider Name="ValueSlider"
              Grid.Column="1"
              DataContext="{Binding SliderSetting, ElementName=Root}"
              Minimum="{Binding MinValue}"
              Maximum="{Binding MaxValue}"
              Value="{Binding CurrentValue, Mode=TwoWay, Converter={StaticResource NumericToDoubleConverter}}"
              TickFrequency="{Binding Step}"
              IsSnapToTickEnabled="{Binding IsSnapToTickEnabled, ElementName=Root}"
              IsEnabled="{Binding IsEnabled}"
              ToolTipService.ShowOnDisabled="True"
              ToolTip="{Binding ToolTip}"
              Style="{DynamicResource Esri_Slider}"
              Margin="0,0,10,0" />

      <TextBox Name="ValueTextBox"
               Grid.Column="2"
               DataContext="{Binding SliderSetting, ElementName=Root}"
               Style="{DynamicResource Esri_TextBoxStyle}"
               IsEnabled="{Binding IsEnabled}"
               FontStyle="{Binding HasLocalOverride, Mode=OneWay, Converter={StaticResource OverrideToFontStyleConverter}}"
               ToolTipService.ShowOnDisabled="True"
               ToolTip="{Binding ToolTip}"
               VerticalAlignment="Center"
               HorizontalContentAlignment="Center" />
    </Grid>
  </StackPanel>
</UserControl>
