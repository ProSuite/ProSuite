<UserControl x:Class="ProSuite.UI.Core.QA.VerificationProgress.VerificationProgressWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:verificationProgress="clr-namespace:ProSuite.UI.Core.QA.VerificationProgress"
             xmlns:commonswpf="clr-namespace:ProSuite.Commons.UI.WPF;assembly=ProSuite.Commons.UI"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Loaded="Window_Loaded"
             PreviewMouseLeftButtonDown="ShowToolTipOfDisabledElement"
             PreviewMouseMove="CloseClickedToolTipWhenMovedAway"
             MouseLeave="CloseClickedToolTip">
    <UserControl.Resources>
        <commonswpf:BoolToColorBrushConverter x:Key="BoolToColorBrushConverter" />
    </UserControl.Resources>
    <UserControl.DataContext>
        <verificationProgress:VerificationProgressViewModel />
    </UserControl.DataContext>
    <DockPanel LastChildFill="False">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="8,5,8,0">
                <!-- Top right buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" UseLayoutRounding="True">
                    <!-- Note: UseLayoutRounding="True" avoids blurry icons -->
                    <StackPanel.Resources>

                        <Style TargetType="{x:Type Button}">
                            <!-- Make the buttons square -->
                            <Setter Property="MinWidth"
                                    Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
                            <Setter Property="MinHeight"
                                    Value="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" />
                            <!-- Disable buttons if not bound to a command -->
                            <Style.Triggers>
                                <Trigger Property="Command" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="false" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <!-- WPF does not grey out images of a disabled button. -->
                        <Style x:Key="DimmedWhenDisabled" TargetType="{x:Type FrameworkElement}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.3" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <Button Command="{Binding OpenWorkListCommand}"
                            CommandParameter="{Binding Mode=OneWay}"
                            ToolTip="{Binding OpenWorkListToolTip}"
                            ToolTipService.ShowOnDisabled="True">
                        <!-- The same drawing as the 'Issue Work List' button in the ribbon. -->
                        <Image Width="16" Height="16" Style="{StaticResource DimmedWhenDisabled}">
                            <Image.Source>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H32 V32 H0 Z" />
                                            <GeometryDrawing Brush="#B00303" Geometry="M15,8.5 A8.5,8.5 0 1 1 32,8.5 A8.5,8.5 0 1 1 15,8.5 Z" />
                                            <GeometryDrawing Brush="#FFFFFF" Geometry="M18,5.5 L20.5,3 L23.5,6 L26.5,3 L29,5.5 L26,8.5 L29,11.5 L26.5,14 L23.5,11 L20.5,14 L18,11.5 L21,8.5 Z" />
                                            <GeometryDrawing Brush="#F7F9FF" Geometry="M2,16 H26 V30 H2 Z" />
                                            <GeometryDrawing Brush="#232323" Geometry="M0,14 H28 V32 H0 Z M2,16 V30 H26 V16 Z" />
                                            <GeometryDrawing Brush="#031D3C" Geometry="M12,18 V28 L6,23 Z M16,18 L22,23 L16,28 Z" />
                                        </DrawingGroup>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Image.Source>
                        </Image>
                    </Button>
                    <Button x:Name="ZoomToPerimeterButton" Margin="4,0,0,0"
                            Command="{Binding ZoomToPerimeterCommand}"
                            CommandParameter="{Binding Mode=OneWay}"
                            ToolTip="{Binding ZoomToVerifiedPerimeterToolTip}"
                            ToolTipService.ShowOnDisabled="True">
                        <!-- The verified perimeter in the green of the tile progress, and a magnifier. -->
                        <Image Width="16" Height="16" Style="{StaticResource DimmedWhenDisabled}">
                            <Image.Source>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
                                            <GeometryDrawing Geometry="M0.5,0.5 H10.5 V10.5 H0.5 Z">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#008000" Thickness="1" />
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                            <GeometryDrawing Geometry="M12.5,12.5 L15.5,15.5">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#232323" Thickness="2" />
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#FFFFFF">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#232323" Thickness="1.2" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="9.5,9.5" RadiusX="4" RadiusY="4" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#232323" Geometry="M9,7 H10 V9 H12 V10 H10 V12 H9 V10 H7 V9 H9 Z" />
                                        </DrawingGroup>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Image.Source>
                        </Image>
                    </Button>
                    <!-- The host application's theme (ArcGIS Pro) styles toggle buttons with rounded
                         corners and a background that looks pressed. The own template and the colours
                         of the neighbouring button make it look like the other buttons. -->
                    <ToggleButton Margin="4,0,0,0"
                                  IsChecked="{Binding ToggleProgressOverlay}"
                                  ToolTip="{Binding ToggleProgressOverlayToolTip}"
                                  MinWidth="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                  MinHeight="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                  Background="{Binding Background, ElementName=ZoomToPerimeterButton}"
                                  BorderBrush="{Binding BorderBrush, ElementName=ZoomToPerimeterButton}"
                                  BorderThickness="{Binding BorderThickness, ElementName=ZoomToPerimeterButton}"
                                  Padding="{Binding Padding, ElementName=ZoomToPerimeterButton}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Rectangle x:Name="StateHighlight" Opacity="0"
                                                   Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <ContentPresenter x:Name="Content"
                                                          Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="StateHighlight" Property="Opacity" Value="0.15" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="StateHighlight" Property="Opacity" Value="0.2" />
                                        <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="StateHighlight" Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <!-- Like the overlay in the map: finished tiles with a green outline, the
                             current tile filled. The tiles are processed from the bottom left to
                             the top right. -->
                        <Canvas Width="16" Height="16" Style="{StaticResource DimmedWhenDisabled}">
                            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="4" Height="4" Fill="#00C800" />
                            <Path Stroke="#008000" StrokeThickness="1"
                                  Data="M0.5,15.5 H15.5 V5.5 H0.5 Z M0.5,10.5 H15.5 M5.5,15.5 V5.5 M10.5,15.5 V5.5 M0.5,5.5 V0.5 H5.5 V5.5" />
                        </Canvas>
                    </ToggleButton>
                </StackPanel>

                <!-- Main progress type -->
                <Label Content="{Binding RunningProgressTypeText}"
                       HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                       Margin="0,0,4,0"
                       Background="{Binding RunningProgressBackColor}" />
            </DockPanel>

            <!-- Progress messages and progress bars -->
            <Border Grid.Row="1" BorderBrush="DarkGray" BorderThickness="1" Margin="8" UseLayoutRounding="True">
                <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           Margin="2">

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" Grid.Row="0"
                               Content="{Binding OverallProgressText}" Visibility="{Binding OverallProgressVisible}"
                               HorizontalAlignment="Left" Margin="3,0,3,0" VerticalAlignment="Center" />

                        <ProgressBar Grid.Column="1" Grid.Row="0" x:Name="overallProgress"
                                     Height="14" Margin="3" VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch" Minimum="0" Maximum="{Binding OverallTotalSteps}"
                                     Value="{Binding OverallCurrentStep}" Visibility="{Binding OverallProgressVisible}" />

                        <Label Grid.Column="0" Grid.Row="1"
                               Content="Tile info" Visibility="{Binding TileInfoVisible}"
                               HorizontalAlignment="Left" Margin="3,8,0,0" VerticalAlignment="Top" />

                        <Border Grid.Column="1" Grid.Row="1" BorderBrush="DarkGray" BorderThickness="0">
                            <TextBox x:Name="currentTileText" Height="36" Margin="3" VerticalAlignment="Top"
                                     HorizontalAlignment="Stretch" TextWrapping="Wrap" Background="Transparent"
                                     IsReadOnly="True" Text="{Binding TileInfoText, Mode=OneWay}"
                                     Visibility="{Binding TileInfoVisible}" />
                        </Border>

                        <Label Grid.Column="0" Grid.Row="2"
                               Content="{Binding DetailProgressText}" Visibility="{Binding DetailProgressVisible}"
                               HorizontalAlignment="Left" Margin="3,0,3,0" VerticalAlignment="Center" />

                        <ProgressBar Grid.Column="1" Grid.Row="2" x:Name="detailProgress"
                                     Height="14" Margin="3" VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch" Minimum="0" Maximum="{Binding DetailTotalSteps}"
                                     Value="{Binding DetailCurrentStep}" Visibility="{Binding DetailProgressVisible}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Errors, Warnings, Checkboxes-->
            <Grid Grid.Row="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- First row: Warnings -->
                <Grid Grid.Row="0" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Warnings" VerticalAlignment="Center" />
                    <Border Grid.Column="1" BorderBrush="DarkGray" BorderThickness="0">
                        <TextBox Text="{Binding WarningCount}" Background="{Binding WarningTextBoxBackColor}"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2"
                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                 FontWeight="Bold" IsReadOnly="True" />
                    </Border>
                    <TextBlock Grid.Column="2" Margin="0,0,15,0" Text="{Binding StartTimeText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- Second row: Errors -->
                <Grid Grid.Row="1" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Errors" VerticalAlignment="Center" Margin="0,5,0,4" />
                    <Border Grid.Column="1" BorderBrush="DarkGray" BorderThickness="0">
                        <TextBox Text="{Binding ErrorCount}" Background="{Binding ErrorTextBoxBackColor}"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2"
                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                 FontWeight="Bold" IsReadOnly="True" />
                    </Border>
                    <TextBlock Grid.Column="2" Margin="0,0,15,0" Text="{Binding EndTimeText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

            </Grid>

            <!-- Buttons -->
            <Grid Row="3" Margin="0,0,0,0">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 0, 5, 0">

                    <!-- Save issues button -->
                    <Button x:Name="saveErrors"
                            Margin="8, 8, 0, 8" Width="100" Height="22" Command="{Binding SaveErrorsCommand}"
                            CommandParameter="{Binding Mode=OneWay}"
                            ToolTip="{Binding SaveErrorsToolTip}"
                            ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <!-- <Image Source="/ProSuite.UI.Core;component/Properties/Images/Save.png" Stretch="None" /> -->
                            <Label Padding="0, 0, 0, 0" Foreground="Black">Update Issues</Label>
                        </StackPanel>
                    </Button>

                    <!-- Save options triangle -->
                    <Button x:Name="saveOptions"
                            Margin="0, 8, 8, 8" Width="22" Height="22"
                            IsEnabled="{Binding IssueOptionsEnabled}">
                        <b:Interaction.Behaviors>
                            <commonswpf:DropDownButtonBehavior />
                        </b:Interaction.Behaviors>
                        <Button.Content>
                            <Path VerticalAlignment="Center" Margin="1,2,1,0"
                                  Fill="{Binding IssueOptionsEnabled, 
                Converter={StaticResource BoolToColorBrushConverter}, 
                ConverterParameter=Black;DarkGray, Mode=OneWay}"
                                  Data="M 0 0 L 5 5 L 10 0 Z" />
                        </Button.Content>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <verificationProgress:UpdateIssuesOptionsControl
                                            DataContext="{Binding UpdateOptions}" />
                                    </ControlTemplate>
                                </ContextMenu.Template>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Show report button -->
                    <Button x:Name="showReport" Content="Show Report"
                            Margin="0" Width="100" Height="22" Command="{Binding ShowReportCommand}"
                            CommandParameter="{Binding Mode=OneWay}"
                            ToolTip="{Binding ShowReportToolTip}"
                            ToolTipService.ShowOnDisabled="True" />

                    <!-- Close/cancel button -->
                    <Button x:Name="cancelTests" Content="{Binding CancelButtonText}"
                            Margin="8" Width="100" Height="22" Command="{Binding CancelCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type verificationProgress:VerificationProgressWpfControl}}}" />

                </StackPanel>
            </Grid>
        </Grid>

        <Border DockPanel.Dock="Bottom" Height="28" BorderBrush="DarkGray" BorderThickness="0, 1, 0, 0">
            <StatusBar Margin="1" Background="#F7F8F8">
                <StatusBarItem>
                    <TextBox Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding StatusTextColor}"
                             Background="Transparent" BorderThickness="0" IsReadOnly="True" />
                </StatusBarItem>
            </StatusBar>
        </Border>
    </DockPanel>
</UserControl>
